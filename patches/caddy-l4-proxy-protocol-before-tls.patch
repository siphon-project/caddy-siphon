 			if err := u.UnmarshalCaddyfile(d.NewFromNextSegment()); err != nil {
@@ -1015,6 +1044,49 @@ func dialWithLocalAddrs(localAddrs []net.Addr, network, addr string) (net.Conn,
 	return nil, lastErr
