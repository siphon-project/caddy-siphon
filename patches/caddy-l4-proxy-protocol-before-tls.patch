@@ -60,6 +60,16 @@ type Handler struct {
 	// Ref: https://www.haproxy.org/download/1.8/doc/proxy-protocol.txt
 	ProxyProtocol string `json:"proxy_protocol,omitempty"`
 
+	// For upstreams that use TLS, send the PROXY protocol header on the raw TCP
+	// connection before the TLS handshake instead of inside the TLS session.
+	// Before the handshake is where the specification puts it ("immediately after
+	// the connection establishment", ahead of any other data), and where HAProxy
+	// `send-proxy-v2 ssl` and nginx `proxy_protocol on` with `proxy_ssl on` send it,
+	// so it is what a TLS server that implements the protocol expects to read.
+	// Off by default to keep the existing placement for backends that want the
+	// header inside the session. Requires proxy_protocol.
+	ProxyProtocolBeforeTLS bool `json:"proxy_protocol_before_tls,omitempty"`
+
