@@ -0,0 +1,50 @@
+{
+	layer4 {
+		0.0.0.0:5061 {
+			route {
+				proxy {
+					proxy_protocol v2 before_tls
+					upstream 10.0.0.1:5061 {
+						tls
+						tls_insecure_skip_verify
+					}
+				}
+			}
+		}
+	}
+}
+----------
+{
+	"apps": {
+		"layer4": {
+			"servers": {
+				"srv0": {
+					"listen": [
+						"0.0.0.0:5061"
+					],
+					"routes": [
+						{
+							"handle": [
+								{
+									"handler": "proxy",
+									"proxy_protocol": "v2",
+									"proxy_protocol_before_tls": true,
+									"upstreams": [
+										{
+											"dial": [
+												"10.0.0.1:5061"
+											],
+											"tls": {
+												"insecure_skip_verify": true
+											}
+										}
+									]
+								}
+							]
+						}
+					]
+				}
+			}
+		}
+	}
+}
